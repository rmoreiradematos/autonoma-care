# Copy to .env. Never commit real secrets.

# SQLite files are created on startup. Use a Postgres URL only after installing a driver.
HOSPITAL_DATABASE_URL=sqlite:///./data/hospital.db
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# Custom MCP server (Streamable HTTP). The agent connects with the official MCP client.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# API
API_HOST=0.0.0.0
API_PORT=8091

# Planner: auto uses the LLM when LLM_API_KEY is set, otherwise the deterministic planner.
# The deterministic planner still executes real MCP tools. It does not invent tool results.
PLANNER_MODE=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Harness limits
MAX_ITERATIONS=12
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RETRIES=2
CONTEXT_TOKEN_BUDGET=6000

# Demo mode seeds synthetic records and allows the documented scripts.
# It does not skip approvals or invent missing personal data.
DEMO_MODE=true
LOG_LEVEL=INFO
